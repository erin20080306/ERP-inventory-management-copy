# PostgreSQL 連線字串 (Supabase / Neon / Railway / Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/erp?schema=public"

# 遠端資料庫或 Serverless 環境可依實測調整。Prisma 預設交易 timeout 只有 5 秒。
PRISMA_TRANSACTION_MAX_WAIT_MS="10000"
PRISMA_TRANSACTION_TIMEOUT_MS="15000"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="please-change-me-to-a-long-random-string"

# 正式雲端主站與租戶專屬子網域。
# Vercel 專案需同時綁定 erin-com.com、www.erin-com.com 與 *.erin-com.com。
PUBLIC_STOREFRONT_ORIGIN="https://www.erin-com.com"
NEXT_PUBLIC_STOREFRONT_ORIGIN="https://www.erin-com.com"
PUBLIC_STOREFRONT_ROOT_DOMAIN="erin-com.com"
NEXT_PUBLIC_STOREFRONT_ROOT_DOMAIN="erin-com.com"

# 預設管理員 (僅 seed 用)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="請設定至少8字元且不可提交到Git"
ADMIN_EMAIL="admin@example.com"

# 通知信（Vercel API Route 透過 Gmail SMTP 寄送）
GMAIL_USER="erin20080306@gmail.com"
GMAIL_APP_PASSWORD=""
CONTACT_TO_EMAIL="erin20080306@gmail.com"

# 中央授權簽章。私鑰只放中央 Vercel；本機安裝只放公鑰。
LICENSE_ED25519_PRIVATE_KEY_B64=""
LICENSE_ED25519_PUBLIC_KEY_B64=""
LICENSE_KEY_SECRET=""
LICENSE_DEVICE_SECRET=""
LICENSE_AUDIT_SECRET=""
INTEGRITY_SECRET=""
CRON_SECRET=""

# AI 智慧問答（Vercel AI SDK + Gemini）。三種擇一；皆無時自動退回關鍵字分派，功能不中斷。
# 優先序：Gateway > 直連 Google。部署在 Vercel 上時 Gateway 可用 OIDC 免金鑰。
#
# (1) Vercel AI Gateway（推薦，Pro 版含額度，統一計費/限額/觀測）
#     於 Vercel 專案 → AI Gateway 建立金鑰後填入；本機開發才需要，正式部署可留空走 OIDC。
AI_GATEWAY_API_KEY=""
AI_GATEWAY_MODEL="google/gemini-2.0-flash"
#
# (2) 直連 Google（不經 Gateway 時使用）。於 https://aistudio.google.com/apikey 申請。
GOOGLE_GENERATIVE_AI_API_KEY=""
AI_MODEL="gemini-2.0-flash"
#
# 智慧補貨 Email 內的連結網址（供 cron 通知信使用）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 電子發票。2026 年正式 Turnkey 以 MIG 4.1 為基準；VAN 規格依選定服務商。
# MOCK 只允許 NEXTAUTH_URL 為 localhost / 127.0.0.1 且明確開啟測試旗標。
EINVOICE_PROVIDER=""
EINVOICE_ALLOW_MOCK="false"
EINVOICE_ENV="TEST"
EINVOICE_MIG_VERSION="4.1"
EINVOICE_SELLER_TAX_ID=""
EINVOICE_TURNKEY_OUTBOX_DIR=""
EINVOICE_TURNKEY_ACK_DIR=""
EINVOICE_VAN_NAME=""
EINVOICE_VAN_BASE_URL=""
EINVOICE_VAN_CLIENT_ID=""
EINVOICE_VAN_CLIENT_SECRET=""
